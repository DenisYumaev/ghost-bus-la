{
  "name": "ghostbus-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:api": "openapi-typescript ../services/api/openapi.json -o lib/api/schema.ts && prettier --write lib/api/schema.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
